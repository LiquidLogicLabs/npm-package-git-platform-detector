{
  "name": "git-platform-detector",
  "version": "1.1.1",
  "description": "Platform detection library for GitHub, Gitea, Bitbucket, and generic git hosts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "npm run build && husky install",
    "build": "tsc -p tsconfig.json",
    "package": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts --no-warn-ignored",
    "format": "prettier --write \"src/**/*.ts\"",
    "test:act": "act --container-options \"--user $(id -u):$(id -g)\" --env-file .act.env --var-file .act.vars --secret-file .act.secrets workflow_dispatch -W .github/workflows/test.yml --eventpath .github/workflows/.act/event-workflow_call.json",
    "test:act:verbose": "act --container-options \"--user $(id -u):$(id -g)\" --env-file .act.env --var-file .act.vars --secret-file .act.secrets workflow_dispatch -W .github/workflows/test.yml --eventpath .github/workflows/.act/event-workflow_call.json -v",
    "test:act:release": "act --container-options \"--user $(id -u):$(id -g)\" --env-file .act.env --var-file .act.vars --secret-file .act.secrets push --eventpath .github/workflows/.act/event-release.json -W .github/workflows/release.yml",
    "test:act:release:verbose": "act --container-options \"--user $(id -u):$(id -g)\" --env-file .act.env --var-file .act.vars --secret-file .act.secrets push --eventpath .github/workflows/.act/event-release.json -W .github/workflows/release.yml -v"
  },
  "keywords": [
    "git",
    "platform",
    "detection",
    "github",
    "gitea",
    "bitbucket"
  ],
  "author": "LiquidLogicLabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.ravenwolf.org/liquidlogiclabs/npm-package-git-platfom-detector"
  },
  "bugs": {
    "url": "https://git.ravenwolf.org/liquidlogiclabs/npm-package-git-platfom-detector/issues"
  },
  "homepage": "https://git.ravenwolf.org/liquidlogiclabs/npm-package-git-platfom-detector",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.0",
    "jest": "^29.7.0",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.3"
  }
}
